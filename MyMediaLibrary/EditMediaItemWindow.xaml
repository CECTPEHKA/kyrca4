<Window x:Class="MyMediaLibrary.EditMediaItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать элемент" Height="450" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Название -->
        <TextBlock Text="Название:" Grid.Row="0" Margin="0,0,0,5"/>
        <TextBox x:Name="TitleTextBox" Grid.Row="1" Margin="0,0,0,10"/>

        <!-- Жанр -->
        <TextBlock Text="Жанр:" Grid.Row="2" Margin="0,0,0,5"/>
        <TextBox x:Name="GenreTextBox" Grid.Row="3" Margin="0,0,0,10"/>

        <!-- Автор -->
        <TextBlock Text="Автор:" Grid.Row="4" Margin="0,0,0,5"/>
        <TextBox x:Name="AuthorTextBox" Grid.Row="5" Margin="0,0,0,10"/>

        <!-- Описание -->
        <TextBlock Text="Описание:" Grid.Row="6" Margin="0,0,0,5"/>
        <TextBox x:Name="DescriptionTextBox" Grid.Row="7" AcceptsReturn="True" Height="60" Margin="0,0,0,10"/>

        <!-- Просмотрено -->
        <TextBlock Text="Просмотрено:" Grid.Row="9" Margin="0,11,0,-6"/>
        <CheckBox x:Name="IsVisitedCheckBox" Grid.Row="9" Margin="85,13,-85,-3"/>


        <!-- Кнопки -->
        <StackPanel Grid.Row="20" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,50,0,0">
            <Button Content="Сохранить" Width="100" Margin="0,0,10,0" Click="SaveButton_Click"/>
            <Button Content="Отмена" Width="100" Click="CancelButton_Click"/>
        </StackPanel>
       
    </Grid>
</Window>