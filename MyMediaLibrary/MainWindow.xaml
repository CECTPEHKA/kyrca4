<Window x:Class="MyMediaLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyMediaLibrary"
        Title="Media Library" Height="500" Width="800">

    <Window.Resources>
        <local:RatingToColorConverter x:Key="RatingToColorConverter"/>

        <Style x:Key="StarButtonStyle" TargetType="Button">
            <Setter Property="Content" Value="★"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2 0 2 0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <StackPanel>
                        <TextBlock Text="Левый клик - целая оценка"/>
                        <TextBlock Text="Ctrl + клик - половинчатая оценка"/>
                    </StackPanel>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBox x:Name="SearchTextBox" Width="200" Height="25"/>
            <Button Content="Поиск книги" Margin="10,0,0,0"
                    Click="SearchBook_Click" Padding="10,5"/>
        </StackPanel>

        <ListView x:Name="MediaListView" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Title}" Width="150"/>
                    <GridViewColumn Header="Автор" DisplayMemberBinding="{Binding Author}" Width="120"/>
                    <GridViewColumn Header="Жанр" DisplayMemberBinding="{Binding Genre}" Width="100"/>
                    <GridViewColumn Header="Прочитано" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsVisited, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Click="VisitedCheckBox_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Рейтинг" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Rating, StringFormat={}{0:0.0}}"/>
                                    <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                                        <!-- Кнопки звёзд -->
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Рейтинг" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Rating, StringFormat={}{0:0.0}}" 
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource StarButtonStyle}" Tag="1"
                                                Foreground="{Binding Rating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=1}"
                                                Click="RatingStar_Click"/>
                                        <Button Style="{StaticResource StarButtonStyle}" Tag="2"
                                                Foreground="{Binding Rating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=2}"
                                                Click="RatingStar_Click"/>
                                        <Button Style="{StaticResource StarButtonStyle}" Tag="3"
                                                Foreground="{Binding Rating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=3}"
                                                Click="RatingStar_Click"/>
                                        <Button Style="{StaticResource StarButtonStyle}" Tag="4"
                                                Foreground="{Binding Rating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=4}"
                                                Click="RatingStar_Click"/>
                                        <Button Style="{StaticResource StarButtonStyle}" Tag="5"
                                                Foreground="{Binding Rating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=5}"
                                                Click="RatingStar_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>

            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Редактировать" Click="EditMenuItem_Click"/>
                    <MenuItem Header="Удалить" Click="DeleteMenuItem_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>
    </Grid>
</Window>
