<Window x:Class="MyMediaLibrary.SearchResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выберите книгу" Height="450" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <ListView x:Name="ResultsListView" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Обложка" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ImagePath}" Height="60" Stretch="Uniform"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Title}" Width="200"/>
                    <GridViewColumn Header="Автор" DisplayMemberBinding="{Binding Author}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Button Content="Добавить выбранную" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom"
                Margin="10" Width="120" Height="30"
                Click="AddButton_Click"/>
    </Grid>
</Window>