<Window x:Class="MyMediaLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"      
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Library" Height="500" Width="800">
    <Grid Margin="10">
        <StackPanel>
            <Button Content="Добавить тестовый элемент" Click="AddTestItem_Click" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="SearchTextBox" Width="200" Height="25"
                 VerticalAlignment="Center"
                 ToolTip="Введите название книги для поиска"/>
                <Button Content="Поиск книги" Click="SearchBook_Click" Margin="10,0,0,0"/>
            </StackPanel>

            <ListView x:Name="MediaListView" ItemsSource="{Binding MediaItems}" Height="300" Margin="0,0,0,10">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Title}" Width="150"/>
                        <GridViewColumn Header="Жанр" DisplayMemberBinding="{Binding Genre}" Width="100"/>
                        <GridViewColumn Header="Автор" DisplayMemberBinding="{Binding Author}" Width="100"/>
                        <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding Date}" Width="120"/>
                        <GridViewColumn Header="Просмотрено" DisplayMemberBinding="{Binding IsVisited}" Width="90"/>
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Редактировать" Click="EditMenuItem_Click"/>
                                    <MenuItem Header="Удалить" Click="DeleteMenuItem_Click"/>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </StackPanel>
    </Grid>
</Window>
