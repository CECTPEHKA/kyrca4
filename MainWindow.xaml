<Window x:Class="MyMediaLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyMediaLibrary"
        mc:Ignorable="d"
        Title="Media Library" Height="500" Width="800"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <StackPanel>
            <Button Content="Добавить тестовый элемент" 
                    Click="AddTestItem_Click" 
                    Margin="0,0,0,10"
                    Padding="10,5"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="SearchTextBox" 
                         Width="200" 
                         Height="25"
                         VerticalAlignment="Center"
                         ToolTip="Введите название книги для поиска"/>
                <Button Content="Поиск книги" 
                        Click="SearchBook_Click" 
                        Margin="10,0,0,0"
                        Padding="10,5"/>
            </StackPanel>

            <ListView x:Name="MediaListView" 
                      Height="300" 
                      Margin="0,0,0,10"
                      SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Title}" Width="150"/>
                        <GridViewColumn Header="Жанр" DisplayMemberBinding="{Binding Genre}" Width="100"/>
                        <GridViewColumn Header="Автор" DisplayMemberBinding="{Binding Author}" Width="100"/>
                        <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="120"/>
                        <GridViewColumn Header="Просмотрено" DisplayMemberBinding="{Binding IsVisited}" Width="90"/>
                    </GridView>
                </ListView.View>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Редактировать" Click="EditMenuItem_Click"/>
                        <MenuItem Header="Удалить" Click="DeleteMenuItem_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <StatusBar>
                <StatusBarItem>
                    <TextBlock x:Name="StatusText" Text="Готово"/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock Text="{Binding ElementName=MediaListView, Path=Items.Count, StringFormat=Элементов: {0}}"/>
                </StatusBarItem>
            </StatusBar>
        </StackPanel>
    </Grid>
</Window>